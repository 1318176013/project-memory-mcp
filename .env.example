# MCP only reads these addresses and credentials. Start PostgreSQL (with pgvector) separately.
PROJECT_MEMORY_SERVICE_CONFIG=./examples/project-memory.service.json
PROJECT_MEMORY_PROJECT_CONFIG=./examples/project-memory.config.json

# Used when service config sets embedding.apiKeyEnv to EMBEDDING_API_KEY.
EMBEDDING_API_KEY=

# --- PostgreSQL container (docker-compose.yml) ---------------------------------
# Credentials for the postgres container. POSTGRES_PASSWORD is required (compose
# refuses to start without it); use a strong value, not the old placeholder.
POSTGRES_DB=project_memory
POSTGRES_USER=project_memory
POSTGRES_PASSWORD=

# Which interface the postgres container binds to.
#   - Leave at 127.0.0.1 for a purely local DB.
#   - On the DB server, set this to the server's ZeroTier IP (e.g. 192.168.194.2)
#     so Postgres is reachable only inside the ZeroTier LAN, never the public net.
PG_BIND_IP=127.0.0.1

# --- MCP database connection ---------------------------------------------------
# Connection string the MCP uses. Topology-dependent:
#   - Local MCP + remote DB over ZeroTier:
#       postgres://project_memory:<password>@192.168.194.1:5432/project_memory
#   - Public single-host deploy (docker-compose.public.yml): the mcp container
#     reaches Postgres by service name, so DATABASE_URL is set inside compose and
#     you do NOT need it here.
DATABASE_URL=postgres://project_memory:project_memory@localhost:5432/project_memory

# --- Public HTTPS gateway (docker-compose.public.yml) --------------------------
# Caddy serves HTTPS for this domain (must already resolve to the server's
# public IP) and auto-provisions a Let's Encrypt certificate.
MCP_DOMAIN=www.example.com

# Shared secret clients send as `Authorization: Bearer <token>`. Caddy enforces
# it on every path (including /mcp). Generate a long random value, e.g.
#   openssl rand -hex 32
MCP_BEARER_TOKEN=

# Embedding endpoint (already referenced by examples/project-memory.service.json).
EMBEDDING_BASE_URL=https://juliang.pro/proxy/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
